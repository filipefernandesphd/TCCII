{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schedule.schema.json",
  "title": "Cronograma normalizado de um semestre",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "semester",
    "source",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "semester": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[12]$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tab"
      ],
      "properties": {
        "tab": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "day",
          "date",
          "module",
          "topic",
          "id"
        ],
        "properties": {
          "day": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^(?:|[0-9]{2}/[0-9]{2}/[0-9]{4})$"
          },
          "module": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "pattern": "^(?:|aula-[0-9]{2})$"
          }
        }
      }
    }
  }
}
